# Email Configuration (using Gmail as free option)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_TO=your-email@gmail.com

# Bandsintown API (Free - get from https://www.bandsintown.com/api/overview)
BANDSINTOWN_APP_ID=concert-tracker

# Songkick API (Free tier - get from https://www.songkick.com/api_key_requests/new)
SONGKICK_API_KEY=your-songkick-api-key

# Check frequency (cron format - default: daily at 9 AM)
CRON_SCHEDULE=0 9 * * *

# Database path
DB_PATH=./data/concerts.db

# Notification preferences
NOTIFY_ON_NEW_CONCERTS=true
NOTIFY_ON_TICKET_SALES=true
MIN_DAYS_NOTICE=7